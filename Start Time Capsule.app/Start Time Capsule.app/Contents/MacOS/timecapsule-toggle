#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TC_ROOT="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
if [ ! -f "$TC_ROOT/scripts/start_server.sh" ]; then
  TC_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
fi

# Check if server is currently running
if curl -s -m 1 http://127.0.0.1:7860/api/health > /dev/null 2>&1 || lsof -ti tcp:7860 -sTCP:LISTEN > /dev/null 2>&1; then
  echo "Server is running. Stopping..."
  bash "$TC_ROOT/scripts/stop_server.sh"
else
  echo "Server is stopped. Starting and opening site..."
  bash "$TC_ROOT/scripts/start_server.sh"
fi
